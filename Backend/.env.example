# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# --- Database -------------------------------------------------------------
# Either supply a single DATABASE_URL (managed hosts do this automatically)...
# DATABASE_URL=postgres://user:password@host:5432/lariogo
# ...or the discrete values below.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=lariogo
DATABASE_PASSWORD=lariogo
DATABASE_NAME=lariogo

# Set to true only for a local Postgres without TLS.
DATABASE_DISABLE_TLS=true

# --- Security -------------------------------------------------------------
# REQUIRED in production; the server refuses to boot without it.
# Generate with:  openssl rand -base64 48
# Minimum 32 characters.
JWT_SECRET=

# Exact origin allowed to call the API from a browser. Omit in development to
# allow any origin; in production an unset value blocks all cross-origin calls.
# CORS_ALLOWED_ORIGIN=https://app.lariogo.example

# --- Runtime --------------------------------------------------------------
# Run pending migrations on boot. Prefer running them as a deploy step instead.
AUTO_MIGRATE=false
LOG_LEVEL=info
